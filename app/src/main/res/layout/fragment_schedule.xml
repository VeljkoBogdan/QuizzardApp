<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.main.ScheduleFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        >

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            >

            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flexDirection="row"
                app:flexWrap="nowrap"
                android:layout_marginHorizontal="8dp"
                android:layout_marginVertical="8dp"
                >

                <Spinner
                    android:id="@+id/scheduleSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_alignSelf="center"
                    />

                <ImageButton
                    android:id="@+id/addButton"
                    android:layout_width="match_parent"
                    app:layout_flexShrink="3"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_add"
                    android:layout_marginStart="4dp"
                    />

                <ImageButton
                    android:id="@+id/menuButton"
                    android:layout_width="match_parent"
                    app:layout_flexShrink="3"
                    android:layout_height="wrap_content"
                    android:src="@drawable/icon_menu"
                    android:layout_marginStart="4dp"
                    />

            </com.google.android.flexbox.FlexboxLayout>

        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_margin="8dp"
            >
            
            <!-- Days -->
            <com.google.android.flexbox.FlexboxLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:flexDirection="row"
                >

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:text="Mon" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAlignment="center"/>
                <TextView android:text="Tue" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAlignment="center"/>
                <TextView android:text="Wed" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAlignment="center"/>
                <TextView android:text="Thu" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAlignment="center"/>
                <TextView android:text="Fri" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAlignment="center"/>
                <TextView android:text="Sat" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAlignment="center"/>
                <TextView android:text="Sun" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAlignment="center"/>

            </com.google.android.flexbox.FlexboxLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                >

                <!-- Time -->
                <com.google.android.flexbox.FlexboxLayout
                    android:layout_width="50dp"
                    android:layout_height="match_parent"
                    app:flexDirection="column">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="06:00"
                        android:gravity="bottom"
                        />

                    <TextView
                        android:gravity="bottom"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="07:00"/>

                    <TextView
                        android:gravity="bottom"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="08:00"/>

                    <TextView
                        android:gravity="bottom"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="09:00"/>

                    <TextView
                        android:gravity="bottom"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="10:00"/>

                    <TextView
                        android:gravity="bottom"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="11:00"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="12:00"
                        android:gravity="bottom"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="13:00"
                        android:gravity="bottom" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="14:00"
                        android:gravity="bottom" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="15:00"
                        android:gravity="bottom" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="16:00"
                        android:gravity="bottom" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="17:00"
                        android:gravity="bottom" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="18:00"
                        android:gravity="bottom" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="19:00"
                        android:gravity="bottom" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="20:00"
                        android:gravity="bottom" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="21:00"
                        android:gravity="bottom" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="22:00"
                        android:gravity="bottom" />

                </com.google.android.flexbox.FlexboxLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/subjectRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>